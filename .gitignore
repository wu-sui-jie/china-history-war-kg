# 环境变量与密钥
.env
*.env
!.env.example
# 例外：deploy/env/ 是部署模板（只含占位符，无真实值），必须入库
!deploy/env/*.env

# 依赖与构建产物
node_modules/
dist/
dist-ssr/
build/
*.local

# Python 生成物
__pycache__/
*.py[cod]
*.egg-info/

# 日志与缓存
logs/
cache/

# 由脚本从源数据重建的派生数据（不进库，避免与源 JSON 重复）
backend/data/processed/

# IDE / 系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# 本机专用脚本：写死了私人代理端口与私人备份仓库名，不适合进公开仓库。
# 本地需要一键备份时保留此文件即可，git 不跟踪。
/backup.cmd

# ---- 本仓库是公开仓库：以下内容一律不入库（本地保留，路径见各 README）----
# 1) 原书全文（受版权约束，不得公开发布）
entity-event-relation/data/中国历代战争简史.txt
entity-event-relation/data/中国战争史地图集.txt
entity-event-relation/data/中国历代战争简史_测试数据.txt
backend/data/raw/
# 2) 由原书派生的数据制品（抽取结果、数据库、评测产物）
entity-event-relation/output/
# 评估的逐次运行产物（A-1）：默认写到 evaluation/run_<时间戳>/，只供本机核对。
# 入库的只有 evaluation/latest 与 evaluation/recheck-* 这两份被加注的历史基线。
entity-event-relation/evaluation/run_*/
# 地理编码的阶段产物（EER-13）：带时间戳的导出 / 编码 / 审核中间文件，不是交付产物
entity-event-relation/war_extraction/geocoding/unmapped_places_*.json
entity-event-relation/war_extraction/geocoding/geocoded_results_*.json
entity-event-relation/war_extraction/geocoding/approved_coordinates_*.json
# 地理编码的逐条进度文件（EER-12）：跑批时不断追加的运行态文件，不是交付产物
entity-event-relation/war_extraction/geocoding/geocoding_progress.jsonl
# 同上，A-2 改成"一批一个文件"后的命名
entity-event-relation/war_extraction/geocoding/geocoding_progress_*.jsonl
backend/database
backend/database.bak-*
# 3) 本机敏感配置（Neo4j 口令、JWT 密钥等）
backend/.env

# ZCode 会话内部文件（计划/记录），不属于项目内容
.zcode/

# 审计/验证过程留下的临时目录（内容为过程产物，不是交付物）
.audit-tmp/
.verify-tmp/

# 工具缓存
.ruff_cache/
.mypy_cache/

# 冒烟脚本生成的临时截图
.smoke-*.png
