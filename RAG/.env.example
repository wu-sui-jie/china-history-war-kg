# ============================================================
# RAG 问答系统环境变量模板
# 复制为 .env 后填写真实值。.env 不入库；本文件入库。
# 离线链路（F09/F11）无需 LLM 密钥即可运行。
# ============================================================

# ---- 路径（可覆盖默认值，默认见 config/defaults.py）----
# RAG_DATA_DIR=            # 数据根目录（默认 RAG/data）
# RAG_LOG_DIR=             # 日志目录（默认 RAG/logs）

# ---- 旧项目只读数据源 ----
# 旧 SQLite 文件位置（F09 只读导出）。留空 = 用默认值（RAG 的上一级目录下的约定路径）；
# 本机绝对路径不要写进入库文件，否则换机器/换用户名就失效。
# LEGACY_SQLITE_PATH=
# 旧原始战争史文本（F11 切分语料来源；多个文件用 ; 分隔）
# LEGACY_RAW_TEXTS=

# ---- 大模型（F02/F06 在线链路；OpenAI 兼容）----
# 密钥不写在这里：从系统环境变量按别名链读取（见下），日志与报错均不回显密钥
#   优先级：LLM_API_KEY → DEEPSEEK_API_KEY → RAG-command（中转，项目期优先）→ RAG-deepseek-v4（官方）
#   切回官方 = 把 RAG-command 从系统环境变量删掉（零代码切换）
# 项目期内走中转（便宜）：
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# 项目结束后走官方：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 输出上限：deepseek 系列是推理模型（先消耗 reasoning token），设过小会导致正文为空
LLM_MAX_TOKENS=3072

# ---- F02 LLM 兜底（词典完全未命中 → 模型抽实体）----
# 默认 false：开启后每问会多一次串行模型调用，直接影响首 Token；演示建议保持关闭
# ENABLE_LLM_ENTITY_FALLBACK=false
# LLM_ENTITY_TIMEOUT_SECONDS=8      # 兜底独立超时（不复用 F06 的 60 s）

# ---- 备用生成模型（主模型失败降级用；需同时配 base_url 与可用密钥才生效）----
# 建议指向官方 endpoint，使"中转不可用 → 自动降级到官方"成为既有降级链的自然行为：
FALLBACK_LLM_BASE_URL=https://api.deepseek.com/v1
FALLBACK_LLM_MODEL=deepseek-flash
# FALLBACK_LLM_API_KEY=        # 留空则默认取 RAG-deepseek-v4（官方密钥）

# ---- 云端文本向量模型（F11 构建向量索引 / F04 向量检索）----
# 已确认模型：阿里云百炼 text-embedding-v4（1024 维，单请求 ≤10 条文本）
# 密钥同样不写在这里：EMBEDDING_API_KEY 留空时读取系统环境变量 DASHSCOPE_API_KEY
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10        # 百炼硬上限：单请求最多 10 条文本（配大只会报错）

# ---- 文本检索模式（向量需先构建：python scripts/build_index.py --vectors-only）----
TEXT_MODE=hybrid               # keyword / vector / hybrid（部署级全局开关，切换需重启；无向量索引时自动降级 keyword）
TEXT_HYBRID_STRATEGY=rrf       # weighted / rrf / fallback（2026-09-13 评测定档：rrf 文本召回最佳）
TEXT_HYBRID_KEYWORD_WEIGHT=0.5 # weighted 档位下关键词通道权重（向量权重 = 1 - 该值）
VECTOR_REFUSAL_MIN_SCORE=0.25  # 向量/hybrid 下"无共享词"拒答的分数阈值
CHROMA_COLLECTION=chunks_v1    # Chroma 集合名（落 data/index/<v>/vectors/chroma/）
# 关键词检索用词上限：调大可提高召回、但 AND 命中会变少
TEXT_QUERY_MAX_WORDS=8         # 查询词总数上限
TEXT_QUERY_AND_WORDS=5         # AND 查询用词数上限
TEXT_QUERY_OR_WORDS=6          # OR 查询用词数上限
TEXT_QUERY_AND_MIN_HITS=3      # AND 命中少于该条数时并入 OR 结果（and_or 模式）

# ---- 治理与索引开关 ----
# 是否执行“高风险补边”(候选关系抽取)。默认 false，需人工审核后再开启
# GOVERNANCE_ENABLE_RELATION_EXTRACTION=false
# 构建索引时是否调用云端向量模型。默认 true，无密钥时可关掉只建 FTS5
# INDEX_BUILD_EMBEDDINGS=true

# ---- 数据版本固定 ----
# 生产必须显式固定活跃数据版本：留空时服务会选"目录里最新的一致版本"，
# 新版本目录一出现，重启就会静默切换数据，无法灰度也无法回滚。
# 配好之后：版本目录缺失会直接启动失败（RAG_REQUIRE_ACTIVE_VERSION 默认随它打开）。
# RAG_ACTIVE_VERSION=20260915_v1
# RAG_REQUIRE_ACTIVE_VERSION=true
# RAG_VERSION_SOURCE=env_pinned     # 版本来源声明，由启动脚本写入（cli_explicit/env_pinned/latest_scan）；
#                                   # 手工启动时不必设，run_server.py --version 会自动写 cli_explicit

# ---- 演示/限流/缓存（在线链路）----
# 示例区恒显示（无 DEMO_MODE 开关）；限流与缓存如下
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_MAX_KEYS=4096          # 限流 key 表容量上限（防伪造来源刷爆内存）
# RATE_LIMIT_TRUST_FORWARDED_FOR=false  # 默认不信任 XFF；部署在反代后才开
# RATE_LIMIT_TRUSTED_PROXIES=       # 可信代理 IP（逗号分隔），配合上一项使用
# CACHE_TTL_SECONDS=3600
# CACHE_MAX_ENTRIES=2048            # 进程内回答缓存条目上限（超出按最旧淘汰）
# HISTORY_MAX_TURNS=4
# QUERY_TOP_K_GRAPH=40
# QUERY_TOP_K_TEXT=30
# QUERY_FUSION_LIMIT=18             # 送入 F06 的融合证据条数上限
#   代码默认 18（v4 口径，prompt 约 4,300 token）；调小可压制推理长度与首字延迟。
#   本仓库演示环境用 10（见 docs/deploy.md 的环境变量表），两者都对——以 .env 实际值为准。

# ---- 请求尺寸与长度上限（超限在调用模型前返回 4xx）----
# REQUEST_MAX_BYTES=65536           # /api/query 请求体字节上限（超出 413）
# QUESTION_MAX_CHARS=500            # 单次提问字符数上限（超出 400）
# SESSION_ID_MAX_CHARS=128
# HISTORY_MAX_ITEMS=40              # 历史消息条数上限
# HISTORY_CONTENT_MAX_CHARS=4000    # 单条历史消息字符数上限
# CORRECTIONS_MAX_ITEMS=20          # corrected_entities 条数上限
# FILTERS_MAX_ITEMS=20              # 单个筛选维度的取值个数上限

# ---- 流式安全与保活 ----
# EXPOSE_THINKING=false             # 是否把模型原始 reasoning 推给公共 SSE（默认关闭）
# SSE_HEARTBEAT_SECONDS=15          # 空闲心跳间隔（`: ping` 注释行）
# SSE_MAX_DURATION_SECONDS=300      # 单次问答整体上限，超时以 error+done(failed) 收流
# CORS_ALLOW_ORIGINS=*              # 生产填站点域名（逗号分隔），不要用 *
# ALLOW_PUBLIC_CORS=false           # 确实要公开 API 时显式打开；生产（RAG_REQUIRE_ACTIVE_VERSION=true）
#                                   # 且 CORS 仍为 * 时，服务启动会直接失败
# SHUTDOWN_DRAIN_SECONDS=10         # 停机时等待在途同步任务的上限；先停收新任务并撤销排队，
#                                   # 再等这个上限，最后才关闭外部 HTTP 客户端

# ---- 非流式问答（POST /api/query/json，供飞书机器人等非浏览器调用方）----
# QUERY_JSON_TIMEOUT_SECONDS=30     # 非流式聚合的超时预算，独立于 SSE 的心跳/总时长。
#                                   # 调用方（飞书机器人 RAG_QUERY_TIMEOUT=25）必须小于它，
#                                   # 构成有意的层层截断：机器人 25s < 本项 30s < LLM 单次 60s×重试
# RAG_BOT_API_KEY=                  # 可选共享密钥：设置后该接口要求请求头 X-Bot-Key，不匹配 401。
#                                   # 留空（或不设置）= 不校验，内网默认。注意不要显式写空值

# ---- 服务端身份校验（/api/query 与 /api/query/json 共用的准入）----
# **模式分档**：把"身份由谁把关"显式化——只用一个布尔开关时，"nginx 在把关"
# 和"根本没人在把关"在配置里长得一模一样。
#
# RAG_AUTH_MODE=jwt                 # 本服务验签（需要 RAG_JWT_SECRET，见下）。
#                                   # 两条问答通道都要求请求头带旧后端签发的 JWT
#                                   # （头名 Token，也接受 Authorization: Bearer），
#                                   # 验不过一律 401。
# RAG_AUTH_MODE=nginx               # 身份交给 nginx（auth_basic）或前置网关，本服务
#                                   # 不验签。此档下服务必须只监听回环地址，否则
#                                   # run_server 拒绝启动（否则可以被直连绕过）。
# RAG_AUTH_MODE=disabled            # 不校验身份。**仅开发环境**：显式生产档
#                                   # （RAG_REQUIRE_ACTIVE_VERSION=true）下会拒绝启动。
# 不设置 = disabled（开发默认，不校验身份）。
# RAG_JWT_SECRET=                   # 与旧后端 backend/.env 的 JWT_SECRET 必须同值；
#                                   # 也接受直接用 JWT_SECRET 这个名字（一台机器只配一次）。
#                                   # jwt 档下不给密钥 = 启动即失败（那会让每个请求都 401），
#                                   # 这是有意的 fail-fast。
# RAG_JWT_ISSUER=china-war-backend  # token 的 iss/aud 必须与 backend/jwt_util.py 的
# RAG_JWT_AUDIENCE=china-war-rag    # ISSUER/AUDIENCE 一致；默认已对齐，一般不用改。
#                                   # 不一致的表现是"验签通过但一律 401"。
# 旧开关 RAG_REQUIRE_AUTH 仍被接受（true 等价于 jwt、false 等价于 disabled），
# 但只用于兼容按旧名字写的配置；新配置请用 RAG_AUTH_MODE。

# ---- 凭证撤销查询（Token Introspection）----
# 验签通过 ≠ 仍然有效：管理员停用账号、使用者改密码之后，旧后端已经拒绝该 token，
# 而本服务如果不查库就会一直放行到 token 自然过期（默认 7 天）——安全动作只在一半
# 系统上生效。配上这两项后，本服务会向旧后端确认一次凭证状态，并在 TTL 内复用结论。
#
# 两项**都**要配齐才算启用；只配一项按"未启用"处理，/api/health 会指名缺的是哪一个。
# 只在 RAG_AUTH_MODE=jwt 档有意义（不验签的档位没有"这张 token 该不该承认"这个问题）。
# RAG_INTROSPECT_URL=http://127.0.0.1:5000/api/internal/token/introspect
#                                   # 旧后端的内部接口（只监听回环，nginx 对
#                                   # /api/internal/ 前缀返回 404，公网不可达）。
# RAG_INTERNAL_SERVICE_KEY=         # 服务间共享密钥，与 backend/.env 的
#                                   # INTERNAL_SERVICE_KEY **必须同值**；也接受
#                                   # INTERNAL_SERVICE_KEY 这个名字（一台机器配一次）。
# RAG_INTROSPECT_TTL_SECONDS=30     # 结论缓存秒数 = **撤销生效延迟的上界**。
#                                   # 调小 = 撤销更快但后端压力更大（每个不同的 token
#                                   # 每 TTL 秒问一次）；调大 = 反之。
# RAG_INTROSPECT_TIMEOUT_SECONDS=3  # 单次查询超时；同机调用正常在毫秒级。
# RAG_REQUIRE_REVOCATION_CHECK=true # 要求撤销查询**必须**配齐（与是否生产档无关）：
#                                   # 配不齐就拒绝启动——给"这个部署必须有它"一个明确写法。
# RAG_ALLOW_DELAYED_REVOCATION=true # 显式接受延迟撤销。生产档（RAG_REQUIRE_ACTIVE_VERSION=true）
#                                   # + jwt 档下**必须二选一**：要么把上面两项配齐（或设
#                                   # RAG_REQUIRE_REVOCATION_CHECK=true），要么设本项。
#                                   # 两个都不做 = 拒绝启动：那条边界不能靠"不填"隐式接受。
# RAG_INTROSPECT_FAIL_MODE=closed   # 后端不可用（连不上/超时/响应看不懂）时的取舍：
#                                   #   closed = 拒绝请求（默认）。这是一条**安全**查询，
#                                   #            "把后端打挂"不该成为绕过撤销的手段；
#                                   #            代价是后端故障期间问答不可用。
#                                   #   open   = 放行。可用性优先，但后端故障期间
#                                   #            所有凭证都不受该检查约束。
#                                   # 必须显式选：拼错会被启动门禁拒绝，不会静默取默认。
# 未启用时的边界（health 的 auth.revocation.policy=delayed）：
#   **账号被停用或改密码后，旧 token 在自然过期前仍可调用本服务的问答接口。**
# health 里还能看到 last_ok_at / last_failure_at / last_failure_reason：
# backend 重启期间"它恢复了吗"是运维最想知道的一件事。
