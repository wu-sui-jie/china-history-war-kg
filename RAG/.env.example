# ============================================================
# RAG 问答系统环境变量模板
# 复制为 .env 后填写真实值。.env 不入库；本文件入库。
# 离线链路（F09/F11）无需 LLM 密钥即可运行。
# ============================================================

# ---- 路径（可覆盖默认值，默认见 config/defaults.py）----
# RAG_DATA_DIR=            # 数据根目录（默认 RAG/data）
# RAG_LOG_DIR=             # 日志目录（默认 RAG/logs）

# ---- 旧项目只读数据源 ----
# 旧 SQLite 文件位置（F09 只读导出）
LEGACY_SQLITE_PATH=F:/python/python_space/china-war/backend/database
# 旧原始战争史文本（F11 切分语料来源；多个文件用 ; 分隔）
LEGACY_RAW_TEXTS=F:/python/python_space/china-war/entity-event-relation/data/中国历代战争简史.txt;F:/python/python_space/china-war/entity-event-relation/data/中国战争史地图集.txt

# ---- 大模型（deepseek-v4-flash，F02/F06 在线链路使用）----
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- 备用生成模型（主模型降级用）----
# FALLBACK_LLM_BASE_URL=
# FALLBACK_LLM_API_KEY=
# FALLBACK_LLM_MODEL=

# ---- 云端文本向量模型（F11 构建向量索引 / F04 向量检索）----
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIM=1024

# ---- 治理与索引开关 ----
# 是否执行“高风险补边”(候选关系抽取)。默认 false，需人工审核后再开启
# GOVERNANCE_ENABLE_RELATION_EXTRACTION=false
# 构建索引时是否调用云端向量模型。默认 true，无密钥时可关掉只建 FTS5
# INDEX_BUILD_EMBEDDINGS=true

# ---- 演示/限流/缓存（在线链路）----
# DEMO_MODE=false
# RATE_LIMIT_PER_MINUTE=30
# CACHE_TTL_SECONDS=3600
# HISTORY_MAX_TURNS=4
# QUERY_TOP_K_GRAPH=40
# QUERY_TOP_K_TEXT=30
