# backend 的本机私有配置模板。
# 复制为 backend/.env 后填入真实值 —— .env 已被 .gitignore 忽略，不会进公开仓库。

# ---- Neo4j（图谱库）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- JWT 登录鉴权密钥 ----
# 留空则在进程内随机生成（本地开发可用，重启后旧 token 失效）；
# 生产或多进程部署必须显式设置，且各进程一致。
JWT_SECRET=

# ---- JWT 有效期（秒）----
# 默认 604800（7 天）。token 泄露只能等它过期，缩短有效期可减小窗口。
# JWT_TTL_SECONDS=604800

# ---- 监听地址与调试开关 ----
# 默认只监听本机、关闭调试。生产由 nginx 反代，保持默认即可；
# 切勿在生产打开 FLASK_DEBUG（Werkzeug 调试器可执行任意代码）。
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=5000
# FLASK_DEBUG=0

# ---- 跨域白名单 ----
# 默认只放行本机开发用的前端来源（前端 :3001 → 后端 :5000）。
# 生产是 nginx 同源反代，不需要跨域；局域网联调时把来源追加进来（逗号分隔）。
# CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---- 日志 ----
# 级别与目录（默认 INFO，日志写到 backend/logs/backend.log，5MB × 3 份轮转）
# BACKEND_LOG_LEVEL=INFO
# BACKEND_LOG_DIR=
