# backend 的本机私有配置模板。
# 复制为 backend/.env 后填入真实值 —— .env 已被 .gitignore 忽略，不会进公开仓库。

# ---- Neo4j（图谱库）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- JWT 登录鉴权密钥 ----
# 留空则在进程内随机生成（本地开发可用，重启后旧 token 失效）；
# 生产或多进程部署必须显式设置，且各进程一致。
JWT_SECRET=

# ---- JWT 有效期（秒）----
# 默认 604800（7 天）。token 泄露只能等它过期，缩短有效期可减小窗口。
# JWT_TTL_SECONDS=604800

# ---- 服务间内部接口密钥 ----
# 供 RAG 调用 /api/internal/token/introspect：确认"这张凭证现在还作不作数"，
# 从而做到"停用账号 / 改密码后 RAG 也立刻拒绝"，而不是等 token 自然过期（默认 7 天）。
# 生成：openssl rand -hex 32；与 RAG/.env 的 RAG_INTERNAL_SERVICE_KEY **必须同值**。
# 留空 = 该内部接口整体返回 503（不校验就放行是更糟的默认），RAG 的撤销查询会一直失败。
# INTERNAL_SERVICE_KEY=

# ---- 登录限流与账号锁定（第 13 轮整改，第 13 轮复核后改为 UTC epoch）----
# 同 IP 每分钟最多几次登录/注册尝试（成功也算一次）；同账号连续失败几次后锁定多少秒。
# 限流数据落在 SQLite 的 login_attempts 表，**落库时间一律是 UTC epoch 秒**——
# 这类计数必须跨进程、跨重启可比，原先写的是 monotonic（开机以来的秒数），
# 机器重启后会把账号凭空锁住几十万秒，或让有效锁定提前失效。
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# LOGIN_FAILURE_LOCK_THRESHOLD=5
# LOGIN_LOCK_SECONDS=900
# LOGIN_FAILURE_WINDOW_SECONDS=900
# 只有在可信反代之后才打开：X-Forwarded-For 是客户端自己能写的头，采信它等于把限流交给攻击者
# LOGIN_TRUST_FORWARDED_FOR=0
# 注册开关：公网部署必须设为 false（否则任何能访问登录页的人都能自助建号）
# ALLOW_SELF_REGISTRATION=true

# ---- 监听地址与调试开关 ----
# 默认只监听本机、关闭调试。生产由 nginx 反代，保持默认即可；
# 切勿在生产打开 FLASK_DEBUG（Werkzeug 调试器可执行任意代码）。
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=5000
# FLASK_DEBUG=0

# ---- 跨域白名单 ----
# 默认只放行本机开发用的前端来源（前端 :3001 → 后端 :5000）。
# 生产是 nginx 同源反代，不需要跨域；局域网联调时把来源追加进来（逗号分隔）。
# CORS_ALLOW_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ---- 日志 ----
# 级别与目录（默认 INFO，日志写到 backend/logs/backend.log，5MB × 3 份轮转）
# BACKEND_LOG_LEVEL=INFO
# BACKEND_LOG_DIR=
