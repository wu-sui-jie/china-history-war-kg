# 旧后端生产配置模板
# 用法：cp deploy/env/backend.env /opt/china-war/backend/.env && chmod 600 ...
#      生成密钥：openssl rand -base64 48
# 说明：应用启动时由 backend/local_settings.py 自动读取，改完重启 china-war-backend 生效。

# ---- Neo4j（图谱库）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# ---- 登录鉴权 ----
# 不设则每次重启随机生成，所有用户都会被强制重新登录
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
#
# token 的 iss / aud 由 backend/jwt_util.py 的 ISSUER / AUDIENCE 常量固定
# （china-war-backend / china-war-rag），必须与 RAG 的 RAG_JWT_ISSUER /
# RAG_JWT_AUDIENCE 一致。两处不一致的表现是"登录成功但问答全 401"，
# 所以刻意不做成环境变量——少一个能被配错的地方。

# ---- 服务间内部接口密钥（第 13 轮复核）----
# RAG 用它调用 /api/internal/token/introspect 查询"这张凭证现在还作不作数"，
# 从而做到"停用账号 / 改密码后 RAG 也立刻拒绝"，而不是等 token 自然过期（默认 7 天）。
# ★ 与 RAG/.env 的 RAG_INTERNAL_SERVICE_KEY **必须同值**（生成：openssl rand -hex 32）。
#   install_services.sh 会调用 check_rag_auth.sh 比对两处取值，不等则拒绝安装。
# ★ 不配 = 该内部接口整体返回 503（未配置密钥时"不校验就放行"是更糟的默认）。
INTERNAL_SERVICE_KEY=CHANGE_ME_openssl_rand_hex_32

# ---- 登录限流与账号锁定（第 13 轮整改，文档第十一节）----
# 同 IP 每分钟最多几次登录/注册尝试（成功也算一次）
LOGIN_RATE_LIMIT_PER_MINUTE=10
# 同账号连续失败几次后锁定，锁定多少秒
LOGIN_FAILURE_LOCK_THRESHOLD=5
LOGIN_LOCK_SECONDS=900
# 只有在**可信反代**（本项目部署形态即 nginx）之后才打开，否则 X-Forwarded-For
# 是客户端自己能写的头，采信它等于把限流交给攻击者决定
LOGIN_TRUST_FORWARDED_FOR=true

# ---- 注册入口 ----
# ★ 公网部署必须设为 false：任何能访问登录页的人都能自助建号，
#   拿到 viewer 身份调接口并消耗模型配额。关闭后新建账号走：
#   cd backend && python create_admin.py --account <账号>
ALLOW_SELF_REGISTRATION=false

# ---- 监听地址 ----
# 只监听回环，外部流量统一走 nginx；不要设成 0.0.0.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# ---- 调试开关 ----
# 生产必须保持关闭：Werkzeug 调试器可执行任意代码
FLASK_DEBUG=0
