# RAG 密钥模板（只放密钥，不放别的配置）
#
# 位置：/etc/china-war/rag-secrets.env
#   sudo cp deploy/env/rag-secrets.env /etc/china-war/rag-secrets.env
#   sudo chmod 600 /etc/china-war/rag-secrets.env
#
# 由 systemd 单元 china-war-rag.service 以 EnvironmentFile 注入，
# 这样密钥不落在项目目录里（RAG/.env.example 明确要求密钥走系统环境变量）。
#
# 非密钥配置（模型地址、检索模式、限流、CORS）在 /opt/china-war/RAG/.env。

# 大模型密钥：优先读 LLM_API_KEY，其次 DEEPSEEK_API_KEY
# 中转与官方各一把时，把常用的填在 LLM_API_KEY，备用端点用的填 DEEPSEEK_API_KEY
LLM_API_KEY=

# 文本向量化（阿里云百炼）：EMBEDDING_API_KEY 留空时会读这个名字
DASHSCOPE_API_KEY=

# 备用生成模型密钥（可选；留空则默认取 DEEPSEEK_API_KEY）
# FALLBACK_LLM_API_KEY=
