# RAG 生产配置模板
# 用法：cp deploy/env/rag.env /opt/china-war/RAG/.env && chmod 600 ...
# 说明：
#   1) 本文件只放**非密钥**配置；密钥（LLM_API_KEY / DASHSCOPE_API_KEY）走
#      /etc/china-war/rag-secrets.env，见 deploy/README.md 第六节。
#   2) 标 ★ 的是生产必改项，不改虽能启动但行为是错的。
#   3) 完整可调项与含义见 RAG/.env.example 与 RAG/docs/deploy.md 第四节。

# ---- 数据版本固定（★ 与 systemd 的 --version 保持一致）----
RAG_ACTIVE_VERSION=20260915_v1
RAG_REQUIRE_ACTIVE_VERSION=true
RAG_VERSION=20260915_v1

# ---- 大模型（OpenAI 兼容端点）----
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=3072

# 备用生成模型：主端点不可用时自动降级
FALLBACK_LLM_BASE_URL=https://api.deepseek.com/v1
FALLBACK_LLM_MODEL=deepseek-flash

# ---- 云端文本向量模型（阿里云百炼）----
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ---- 检索 ----
TEXT_MODE=hybrid
TEXT_HYBRID_STRATEGY=rrf
CHROMA_COLLECTION=chunks_v1
QUERY_FUSION_LIMIT=18

# ---- 限流与缓存 ----
RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=3600

# ★ 放在了 nginx 后面，必须信任反代传来的 X-Forwarded-For，
#   否则 RAG 看到的来源全是 127.0.0.1，限流退化成“全站合计 30 次/分钟”。
RATE_LIMIT_TRUST_FORWARDED_FOR=true
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1

# ★ 显式生产档下 CORS 不能是 *（服务会直接拒绝启动）。
#   二选一：
#     a) 收窄到实际访问地址（推荐）——只用 IP 就写 http://1.2.3.4，有域名写 https://your.domain
#     b) 确实要公开 API：注释掉下一行，改为 ALLOW_PUBLIC_CORS=true
CORS_ALLOW_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN

# ---- 非流式问答（飞书机器人用）----
# 机器人侧 RAG_QUERY_TIMEOUT=25 必须小于本项，构成有意的层层截断
QUERY_JSON_TIMEOUT_SECONDS=30
# 可选共享密钥：两处（RAG 与 feishu-bot）填同一个值；都留空 = 不校验（内网默认）
# RAG_BOT_API_KEY=

# ---- 服务端身份校验（第 12 轮审查 P1-1 / 第 13 轮整改，第 13 轮复核后收口）----
# ★ 对外部署必须显式二选一，不许留空：
#
#   RAG_AUTH_MODE=jwt     本服务验签（需要 RAG_JWT_SECRET，见下）—— **生产默认**
#   RAG_AUTH_MODE=nginx   由 nginx 把 /rag/ 的 auth_basic 挡住，本服务只监听回环
#   RAG_AUTH_MODE=disabled  不校验身份，**只允许开发环境**
#
# ★ 为什么默认改成 jwt（第 13 轮复核第五节）：模板原先写 nginx，而
#   deploy/nginx/china-war.conf 里的 auth_basic 是**注释状态**。照着两份模板部署的人
#   会得到"RAG 以为 nginx 在鉴权、nginx 实际没鉴权"的组合——两边都能正常启动、
#   日志里没有异常，唯一后果是公网 RAG 没有访问控制。"两边各自看起来都配了"
#   这种缺陷只能靠**默认值选安全的那一边** + 安装脚本校验来消除。
#   用 jwt 档还有个好处：用户只登录一次旧知识库，不必再记一个 Basic Auth 口令，
#   访问控制与旧系统的账号体系同源（谁被停用，谁就进不来）。
#
# ★ 显式生产档（RAG_REQUIRE_ACTIVE_VERSION=true）下 disabled 会**拒绝启动**：
#   原先只有一个布尔开关，"nginx 在把关"与"根本没人在把关"在配置里长得一样，
#   漏配的人只会看到一条被忽略的 WARNING，于是接口对知道地址的任何人开放。
# ★ nginx 档下若监听的不是回环地址（如 --host 0.0.0.0），run_server 也会拒绝启动：
#   那种情况下同网段可以直接连后端端口绕过 nginx，鉴权形同不存在。
RAG_AUTH_MODE=jwt
# 开启 jwt 档后 /api/query（SSE）与非流式接口都要求请求头带旧后端签发的 JWT；
# 主应用内嵌的 iframe 会自动带上（RagAssistant.vue 的 postMessage）。
# 副作用：**直接打开 /rag/ 无法问答**——这正是"只允许已登录用户使用"的效果。
#
# ★ 与 backend/.env 的 JWT_SECRET **必须同值**，否则验签必然失败、问答全 401。
#   两边不一致是这套校验最容易踩的坑；install_services.sh 会调用
#   check_rag_auth.sh 自动比对两处取值，不等则拒绝安装。
RAG_JWT_SECRET=
#
# token 的 iss / aud 必须与 backend/jwt_util.py 的 ISSUER / AUDIENCE 一致，
# 不一致的表现同样是"验签通过但一律 401"。默认值已经对齐，一般不用改。
# RAG_JWT_ISSUER=china-war-backend
# RAG_JWT_AUDIENCE=china-war-rag
#
# 旧开关 RAG_REQUIRE_AUTH 仍被接受（true 等价于 jwt、false 等价于 disabled），
# 仅为兼容改造前写的配置文件；新配置请用 RAG_AUTH_MODE。
# RAG_REQUIRE_AUTH=false

# ---- 凭证撤销查询（第 13 轮复核，文档第四节方案 B：Token Introspection）----
# ★ 强烈建议开启。不开的话有个后果必须知道：
#   **账号被停用或改密码后，旧 token 在自然过期前（默认 7 天）仍能调用 RAG 问答接口。**
#   旧后端本身会立刻拒绝该凭证，于是安全动作只在一半系统上生效。
# 开启后 RAG 会向旧后端确认凭证状态，并在 TTL 内复用结论（撤销生效延迟的上界 = TTL）。
RAG_INTROSPECT_URL=http://127.0.0.1:5000/api/internal/token/introspect
# ★ 与 backend/.env 的 INTERNAL_SERVICE_KEY **必须同值**；生成：
#   openssl rand -hex 32
RAG_INTERNAL_SERVICE_KEY=
# 结论缓存秒数 = 撤销生效延迟的上界（调小更快、后端压力更大）
RAG_INTROSPECT_TTL_SECONDS=30
RAG_INTROSPECT_TIMEOUT_SECONDS=3
# 后端不可用时的取舍：closed（拒绝请求，默认）/ open（放行）
#   closed 的理由：这是一条**安全**查询，"把后端打挂"不该成为绕过撤销的手段；
#   代价是后端故障期间问答不可用。要换成 open 就显式写出来。
RAG_INTROSPECT_FAIL_MODE=closed

# ---- 停机 ----
SHUTDOWN_DRAIN_SECONDS=10
