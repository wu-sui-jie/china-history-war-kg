# RAG 生产配置模板
# 用法：cp deploy/env/rag.env /opt/china-war/RAG/.env && chmod 600 ...
# 说明：
#   1) 本文件只放**非密钥**配置；密钥（LLM_API_KEY / DASHSCOPE_API_KEY）走
#      /etc/china-war/rag-secrets.env，见 deploy/README.md 第六节。
#   2) 标 ★ 的是生产必改项，不改虽能启动但行为是错的。
#   3) 完整可调项与含义见 RAG/.env.example 与 RAG/docs/deploy.md 第四节。

# ---- 数据版本固定（★ 与 systemd 的 --version 保持一致）----
RAG_ACTIVE_VERSION=20260915_v1
RAG_REQUIRE_ACTIVE_VERSION=true
RAG_VERSION=20260915_v1

# ---- 大模型（OpenAI 兼容端点）----
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=3072

# 备用生成模型：主端点不可用时自动降级
FALLBACK_LLM_BASE_URL=https://api.deepseek.com/v1
FALLBACK_LLM_MODEL=deepseek-flash

# ---- 云端文本向量模型（阿里云百炼）----
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ---- 检索 ----
TEXT_MODE=hybrid
TEXT_HYBRID_STRATEGY=rrf
CHROMA_COLLECTION=chunks_v1
QUERY_FUSION_LIMIT=18

# ---- 限流与缓存 ----
RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=3600

# ★ 放在了 nginx 后面，必须信任反代传来的 X-Forwarded-For，
#   否则 RAG 看到的来源全是 127.0.0.1，限流退化成“全站合计 30 次/分钟”。
RATE_LIMIT_TRUST_FORWARDED_FOR=true
RATE_LIMIT_TRUSTED_PROXIES=127.0.0.1

# ★ 显式生产档下 CORS 不能是 *（服务会直接拒绝启动）。
#   二选一：
#     a) 收窄到实际访问地址（推荐）——只用 IP 就写 http://1.2.3.4，有域名写 https://your.domain
#     b) 确实要公开 API：注释掉下一行，改为 ALLOW_PUBLIC_CORS=true
CORS_ALLOW_ORIGINS=http://YOUR_SERVER_IP_OR_DOMAIN

# ---- 非流式问答（飞书机器人用）----
# 机器人侧 RAG_QUERY_TIMEOUT=25 必须小于本项，构成有意的层层截断
QUERY_JSON_TIMEOUT_SECONDS=30
# 可选共享密钥：两处（RAG 与 feishu-bot）填同一个值；都留空 = 不校验（内网默认）
# RAG_BOT_API_KEY=

# ---- 停机 ----
SHUTDOWN_DRAIN_SECONDS=10
