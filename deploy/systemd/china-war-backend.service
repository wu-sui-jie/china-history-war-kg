# 旧知识库后端（Flask :5000）
#
# 安装：
#   sudo cp deploy/systemd/china-war-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now china-war-backend
# 日志：journalctl -u china-war-backend -f

[Unit]
Description=干戈纪略 · 旧知识库后端（Flask :5000）
Documentation=file:///opt/china-war/deploy/README.md
After=network-online.target neo4j.service
Wants=network-online.target

[Service]
Type=simple
User=chinawar
Group=chinawar

# 必须从 backend/ 启动：rules/rule_base.json 按当前工作目录解析
WorkingDirectory=/opt/china-war/backend

Environment=PYTHONUNBUFFERED=1
Environment=BACKEND_HOST=127.0.0.1
Environment=BACKEND_PORT=5000

# Neo4j 口令 / JWT 密钥由 backend/.env 提供（应用启动时自行读取），
# 所以这里不需要 EnvironmentFile；文件权限建议 600 chinawar:chinawar。

ExecStart=/opt/miniconda3/envs/china-war-backend/bin/python app.py

Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# 单进程 + 多线程（Flask 默认），SQLite 已开 WAL，够几十人内部使用；
# 需要更高并发见 deploy/README.md 第十节。

StandardOutput=journal
StandardError=journal
SyslogIdentifier=china-war-backend

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
