# RAG 问答服务（FastAPI :8000，同源托管 RAG 前端）
#
# 安装：
#   sudo cp deploy/systemd/china-war-rag.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now china-war-rag
# 日志：journalctl -u china-war-rag -f
#
# 密钥（LLM_API_KEY / DASHSCOPE_API_KEY）从 /etc/china-war/rag-secrets.env 注入，
# 不写进项目目录，见 deploy/README.md 第六节。

[Unit]
Description=干戈纪略 · RAG 问答服务（FastAPI :8000）
Documentation=file:///opt/china-war/deploy/README.md
# 依赖 backend（第 13 轮复核整改 §2.9）：RAG 的凭证撤销查询要调旧后端的
# /api/internal/token/introspect，而 RAG_INTROSPECT_FAIL_MODE=closed（默认）下
# 后端不可用 = 所有 JWT 用户的问答全部失败。之前这里只依赖 network-online，
# 于是 RAG 可能先于 backend 起来、并在后端还没就绪的那段时间里把用户全部拒掉。
#
# 说明：`After`/`Wants` 保证的是**启动顺序**，不保证"backend 已经能响应请求"
# （进程起来与端口可用之间有间隔）。那段时间的失败由 introspect 的失败策略兜底：
# fail_mode=open 时放行、closed 时拒绝，且 health 的 auth.revocation 会记下
# 最近一次失败——这是有意的取舍，不是遗漏。
After=network-online.target china-war-backend.service
Wants=network-online.target china-war-backend.service

[Service]
Type=simple
User=chinawar
Group=chinawar
WorkingDirectory=/opt/china-war/RAG

Environment=PYTHONUNBUFFERED=1

# 非密钥配置（模型地址、检索模式、限流、CORS…）在 /opt/china-war/RAG/.env 里由应用自读。
# 这里只注入密钥，文件权限应为 600 root:root。
EnvironmentFile=-/etc/china-war/rag-secrets.env

# --version 固定数据版本：换数据版本时改这一行，**同时**把 RAG/.env 的
# RAG_ACTIVE_VERSION 一起改（两者必须一致；不一致时 health 里的 version_selection
# 与实际加载的版本会对不上）。注意键名是 RAG_ACTIVE_VERSION —— 曾经的 RAG_VERSION
# 是个没有任何代码读的死键，已在第 14 轮审计 P2-24 从模板删除。
ExecStart=/opt/miniconda3/envs/china-war-rag/bin/python scripts/run_server.py \
    --host 127.0.0.1 --port 8000 --version 20260915_v1

Restart=on-failure
RestartSec=5s

# 停机时先停收新任务并等在途同步任务，给 RAG 的 SHUTDOWN_DRAIN_SECONDS 留出余量
TimeoutStopSec=60s

# workers 固定为 1：内存图谱、回答缓存、限流计数都在进程内，多 worker 会各持一份

StandardOutput=journal
StandardError=journal
SyslogIdentifier=china-war-rag

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
