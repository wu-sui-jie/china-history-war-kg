# 飞书机器人服务配置模板。
# 用法：cp .env.example .env，填入真实值；.env 不入库（见仓库根 .gitignore）。
# 完整说明见 docs/开发文档.md 第八节。

# ---- 必填：飞书开放平台 → 企业自建应用 → 凭证与基础信息 ----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- RAG 服务（默认本机 8000；RAG 与机器人可不同机，填内网地址即可）----
RAG_BASE_URL=http://127.0.0.1:8000

# 可选共享密钥：设置后本端会带 X-Bot-Key 头发送。
# 需与 RAG 侧同名环境变量 RAG_BOT_API_KEY 完全一致；两边都留空 = 不校验（内网默认）。
RAG_BOT_API_KEY=

# 机器人等待 RAG 的读超时（秒）。必须**小于** RAG 侧 QUERY_JSON_TIMEOUT_SECONDS（默认 30）：
# 本端先超时才能拿到明确的超时原因，而不是等服务端掐断连接。
RAG_QUERY_TIMEOUT=25
RAG_CONNECT_TIMEOUT=5

# ---- 纠错反馈投递（P2）----
# 运营群 chat_id（oc_ 开头）。留空时反馈只落 SQLite、不投递，启动日志会给出警告。
# 机器人须已加入该群，否则工单发不出去。
FEISHU_OPERATORS_CHAT_ID=

# ---- 状态存储 ----
# SQLite 路径（默认 feishu-bot/data/bot.db，目录自动创建；已被 .gitignore 排除）
BOT_DB_PATH=

# 会话 TTL（小时）：历史组装的时间窗（软口径）。物理清理见 scripts/cleanup_db.py。
SESSION_TTL_HOURS=24

# ---- 历史组装边界（一般不需要改）----
# 总字节预算：RAG 的 REQUEST_MAX_BYTES=64KB 在参数校验之前生效，
# 这里按 40KB 组装历史，避免长会话拿到 413（开发文档 5.2）。
HISTORY_MAX_BYTES=40960
HISTORY_MAX_ITEMS=40
HISTORY_CONTENT_MAX_CHARS=4000

# ---- 卡片交互 ----
# 示例问题按钮（P1-3）：从 RAG /api/demo/examples 取题；接口失败时按钮区不渲染。
DEMO_EXAMPLES_ENABLED=true
DEMO_EXAMPLES_COUNT=3
DEMO_EXAMPLES_REFRESH_SECONDS=3600

# 子图服务端出图（P2-1）：需要部署机装好 Node ≥ 18 并在 feishu-bot/render 执行过
# `npm install echarts @resvg/resvg-js d3-force`。关闭则子图始终走文字降级。
SUBGRAPH_RENDER_ENABLED=true
SUBGRAPH_RENDER_TIMEOUT=10

# ---- 运维 ----
BOT_LOG_LEVEL=INFO
# 事件去重记录保留时长（小时）：飞书重投通常集中在 1 分钟内，24h 足够
PROCESSED_EVENTS_TTL_HOURS=24
# 卡片回调缺少 event_id 时的退化去重窗口（秒）。取得很小是有意的——
# 连点两次同一按钮必须两条都处理（P0-4 验收），窗口只用来压制同一次点击的重投。
CARD_DEDUPE_WINDOW_SECONDS=2
